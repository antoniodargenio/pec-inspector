# Example environment for pec-inspector. Load it with your shell / secret manager; the tool does not read .env itself.
# Single mailbox
PEC_ADDRESS=user@example-pec.test
PEC_PASSWORD=change-me
# PEC_USERNAME=login-name-if-different-from-the-address

# Skip IMAP auto-discovery
# PEC_IMAP_HOST=imap.example.test
# PEC_IMAP_PORT=993
# PEC_IMAP_SECURITY=ssl

# Several mailboxes: a credentials file plus --address, or one password variable per mailbox
# PEC_CREDENTIALS_FILE=/path/to/credentials.tsv
# PEC_PASSWORD_USER_EXAMPLE_PEC_TEST=change-me
# PEC_PASSWORD_OTHER_EXAMPLE_TEST=change-me-too
